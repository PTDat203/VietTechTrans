    <!-- Conversation rules (empty chat and the ⓘ button) -->
    <string name="rules_title">Cách nói chuyện qua app</string>
    <string name="rule_1">Mỗi lần chỉ một người nói; người kia chờ app đọc bản dịch xong.</string>
    <string name="rule_1_en">One person speaks at a time; the other waits until the translation is read.</string>
    <string name="rule_2">Chạm đúng nút ngôn ngữ của mình: Tiếng Việt hoặc English.</string>
    <string name="rule_2_en">Tap your own language: Tiếng Việt or English.</string>
    <string name="rule_3">Nói câu ngắn, rõ, gần micro. Nói xong im lặng 1,5 giây hoặc chạm lại nút.</string>
    <string name="rule_3_en">Speak short, clear sentences near the mic. When done, pause 1.5 s or tap again.</string>
    <string name="rule_4">Xem câu app nghe được trong khung chat; nếu sai, bấm ✎ để sửa và dịch lại.</string>
    <string name="rule_4_en">Check what the app heard in the chat; if it is wrong, tap ✎ to fix it.</string>
    <string name="rule_5">App đọc bản dịch cho người kia. Muốn ngắt, chạm nút micro của mình.</string>
    <string name="rule_5_en">The app reads the translation aloud. Tap your mic to interrupt.</string>
    <string name="rule_6">Tên riêng, địa danh, thuật ngữ khó: gõ bằng ⌨ để chính xác hơn. Chạm vào bản dịch để phóng to cho người kia đọc.</string>
    <string name="rule_6_en">For names, places or hard terms, type with ⌨. Tap a translation to show it large.</string>

