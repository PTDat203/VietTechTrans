<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: open Dịch ảnh (picture picker) or Dịch nhanh directly (Incoming.ACTION_*). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_image"
        android:shortcutId="image_translate"
        android:shortcutLongLabel="@string/shortcut_image_long"
        android:shortcutShortLabel="@string/shortcut_image">
        <intent
            android:action="vn.viettechtrans.app.action.IMAGE_TRANSLATE"
            android:targetClass="vn.viettechtrans.app.MainActivity"
            android:targetPackage="vn.viettechtrans.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_translate"
        android:shortcutId="quick_translate"
        android:shortcutLongLabel="@string/shortcut_translate_long"
        android:shortcutShortLabel="@string/nav_translate">
        <intent
            android:action="vn.viettechtrans.app.action.QUICK_TRANSLATE"
            android:targetClass="vn.viettechtrans.app.MainActivity"
            android:targetPackage="vn.viettechtrans.app" />
    </shortcut>
</shortcuts>
