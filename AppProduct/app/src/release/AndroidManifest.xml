<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds stay profileable so RAM/CPU can be measured on a real phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>
</manifest>
